# systemd unit for Vantage Personal Arb Scanner
# Place in /etc/systemd/system/arb.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now arb
# Requires: xvfb installed (provides virtual display so headed 1xbet works on server)

[Unit]
Description=Vantage Arbitrage Scanner
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/vantage-ai
# xvfb-run gives Chromium a virtual display (1xbet needs headed mode even on server)
ExecStart=/usr/bin/xvfb-run -a /usr/bin/node backend/personal_arb/arb_scanner_live.js --loop=2
Restart=always
RestartSec=10
Environment=TELEGRAM_BOT_TOKEN=
Environment=TELEGRAM_CHAT_ID=
Environment=DISPLAY=:99

[Install]
WantedBy=multi-user.target